.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx; }
.header { background: linear-gradient(135deg, #667eea, #764ba2); padding: 40rpx 30rpx; color: #fff; }
.user-row { display: flex; align-items: center; }
.avatar-box { width: 96rpx; height: 96rpx; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin-right: 20rpx; }
.user-info { flex: 1; }
.nickname { font-size: 32rpx; font-weight: bold; display: block; }
.level-badge { display: flex; align-items: center; margin-top: 8rpx; }
.level-icon { font-size: 24rpx; margin-right: 6rpx; color: #ffd700; }
.level-name { font-size: 24rpx; background: rgba(255,255,255,0.2); padding: 2rpx 12rpx; border-radius: 8rpx; }
.status-tip { font-size: 24rpx; margin-top: 12rpx; opacity: 0.85; display: block; }
.earnings-section { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.earnings-total { text-align: center; margin-bottom: 20rpx; }
.earnings-label { font-size: 26rpx; color: #999; display: block; }
.earnings-value { font-size: 48rpx; font-weight: bold; color: #f5222d; display: block; margin-top: 8rpx; }
.earnings-cards { display: flex; justify-content: space-around; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; border-bottom: 1rpx solid #f0f0f0; }
.earnings-card { text-align: center; }
.card-value { font-size: 28rpx; font-weight: bold; color: #333; display: block; }
.card-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.withdraw-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.withdraw-btn { background: #f5222d; color: #fff; padding: 12rpx 32rpx; border-radius: 30rpx; font-size: 26rpx; }
.withdraw-balance { font-size: 24rpx; color: #666; }
.rules-section { background: #fff; margin: 0 24rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.rule-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.rule-item:last-child { border-bottom: none; }
.rule-level { font-size: 26rpx; color: #333; font-weight: 500; }
.rule-commission { font-size: 24rpx; color: #4A90D9; }
.tab-bar { display: flex; background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; }
.tab-item.active { color: #4A90D9; font-weight: bold; background: #f0f5ff; }
.tab-content { margin: 0 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.team-summary { display: flex; justify-content: space-around; }
.summary-item { text-align: center; }
.summary-value { font-size: 36rpx; font-weight: bold; color: #4A90D9; display: block; }
.summary-label { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.commission-item { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.commission-item:last-child { border-bottom: none; }
.commission-left { flex: 1; }
.commission-course { font-size: 28rpx; color: #333; display: block; }
.commission-time { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.commission-right { text-align: right; }
.commission-amount { font-size: 30rpx; font-weight: bold; color: #f5222d; display: block; }
.commission-level { font-size: 22rpx; color: #999; display: block; }
.promote-section { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 24rpx; background: #fff; }
.promote-btn { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-radius: 44rpx; font-size: 32rpx; font-weight: bold; }
.empty-tip { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx 0; }
.member-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.member-item:last-child { border-bottom: none; }
.member-avatar { width: 56rpx; height: 56rpx; background: #4A90D9; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; margin-right: 16rpx; }
.member-name { flex: 1; font-size: 28rpx; color: #333; }
.member-time { font-size: 22rpx; color: #999; }
