.container {
  padding: 30rpx;
}
.header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.desc {
  font-size: 26rpx;
  color: #999;
}
.progress-section {
  margin: 30rpx 0;
}
.progress-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}
.result-section {
  margin: 20rpx 0;
  max-height: 600rpx;
  overflow-y: auto;
}
.result-item {
  padding: 15rpx 20rpx;
  margin: 5rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.result-item.success {
  background: #f0fff0;
  color: #07c160;
}
.result-item.fail {
  background: #fff0f0;
  color: #fa5151;
}
.btn-section {
  margin-top: 40rpx;
}
.import-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.import-btn.secondary {
  background: #f0f0f0;
  color: #333;
}
.step-text {
  font-size: 28rpx;
  color: #4A90D9;
  text-align: center;
  margin: 20rpx 0;
}
.tips {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #FFF8E1;
  border-radius: 8rpx;
}
.tip-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin: 5rpx 0;
}