.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  background-color: #fff;
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.content {
  padding: 20rpx;
}

.course-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.course-info {
  flex: 1;
  margin-right: 20rpx;
}

.course-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.course-meta {
  display: flex;
  align-items: center;
}

.course-label {
  font-size: 24rpx;
  color: #999;
}

.course-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff6b6b;
}

.price-value {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.amount-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.amount-row:first-child {
  border-bottom: 1rpx solid #f0f0f0;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 28rpx;
  color: #999;
}

.amount-total {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.pay-method {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.method-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
}

.method-item.selected {
  border-color: #07c160;
  background-color: #f0fff4;
}

.method-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.method-icon image {
  width: 100%;
  height: 100%;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.method-check {
  width: 36rpx;
  height: 36rpx;
}

.method-check image {
  width: 100%;
  height: 100%;
}

.tips {
  padding: 20rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 40rpx;
}

.error-state {
  padding: 100rpx 50rpx;
  text-align: center;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.error-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background-color: #4A90D9;
  border-radius: 40rpx;
}

.error-btn-text {
  font-size: 28rpx;
  color: #fff;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.total-price {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.pay-btn {
  width: 240rpx;
  height: 80rpx;
  background-color: #07c160;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-btn.paying {
  background-color: #a0d7b0;
}

.pay-btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
}
