<view class="container">
  <view class="header">
    <text class="header-title">订单确认</text>
  </view>

  <view class="content" wx:if="{{!loading && courseInfo}}">
    <!-- 课程信息 -->
    <view class="course-card">
      <view class="course-info">
        <text class="course-title">{{courseInfo.title}}</text>
        <view class="course-meta">
          <text class="course-label">课程购买</text>
        </view>
      </view>
      <view class="course-price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{priceDisplay}}</text>
      </view>
    </view>

    <!-- 支付金额 -->
    <view class="amount-section">
      <view class="amount-row">
        <text class="amount-label">商品金额</text>
        <text class="amount-value">¥{{priceDisplay}}</text>
      </view>
      <view class="amount-row">
        <text class="amount-label">应付总额</text>
        <text class="amount-total">¥{{priceDisplay}}</text>
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="pay-method">
      <view class="method-title">支付方式</view>
      <view class="method-item selected">
        <view class="method-icon">
          <image src="/assets/images/icon_wechat.png" mode="aspectFit"></image>
        </view>
        <text class="method-name">微信支付</text>
        <view class="method-check">
          <image src="/assets/images/icon_check.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips">
      <text class="tips-text">1. 支付成功后，课程将直接添加到您的学习中心</text>
      <text class="tips-text">2. 支持微信支付安全加密，保障您的资金安全</text>
      <text class="tips-text">3. 如有疑问，请联系客服</text>
    </view>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{errorMsg && !loading}}">
    <text class="error-text">{{errorMsg}}</text>
    <view class="error-btn" bindtap="onRetryPay">
      <text class="error-btn-text">重新加载</text>
    </view>
  </view>

  <!-- 底部支付栏 -->
  <view class="bottom-bar" wx:if="{{courseInfo && !errorMsg}}">
    <view class="total-info">
      <text class="total-label">实付款</text>
      <text class="total-price">¥{{priceDisplay}}</text>
    </view>
    <view class="pay-btn {{paying ? 'paying' : ''}}" bindtap="createPayment">
      <text class="pay-btn-text" wx:if="{{!paying}}">立即支付</text>
      <text class="pay-btn-text" wx:else>支付中...</text>
    </view>
  </view>
</view>
