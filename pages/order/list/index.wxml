<view class="container">
  <!-- 标签栏 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" data-status="all" bindtap="onTabChange">
      <text class="tab-text">全部</text>
    </view>
    <view class="tab-item {{currentTab === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onTabChange">
      <text class="tab-text">待支付</text>
    </view>
    <view class="tab-item {{currentTab === 'paid' ? 'active' : ''}}" data-status="paid" bindtap="onTabChange">
      <text class="tab-text">已支付</text>
    </view>
    <view class="tab-item {{currentTab === 'refunded' ? 'active' : ''}}" data-status="refunded" bindtap="onTabChange">
      <text class="tab-text">已退款</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" data-order="{{item}}" bindtap="onOrderTap">
      <view class="order-header">
        <text class="order-no">订单号: {{item.outTradeNo}}</text>
        <view class="order-status {{item.status}}">
          <text class="status-text">{{item.statusText}}</text>
        </view>
      </view>
      
      <view class="order-content">
        <view class="course-info">
          <text class="course-title">{{item.courseName || item.courseInfo.title || '课程'}}</text>
          <text class="course-time">{{item.createTimeStr}}</text>
        </view>
        <view class="order-amount">
          <text class="amount">¥{{item.priceDisplay}}</text>
        </view>
      </view>
      
      <view class="order-footer" wx:if="{{item.status === 'pending'}}">
        <view class="pay-btn" catchtap="onPayOrder" data-order="{{item}}">
          <text class="pay-btn-text">去支付</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <image class="empty-icon" src="/assets/images/icon_empty.png" mode="aspectFit"></image>
    <text class="empty-text">{{emptyText}}</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text class="no-more-text">— 没有更多了 —</text>
  </view>
</view>
