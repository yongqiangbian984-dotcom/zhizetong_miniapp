.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  padding: 30rpx 0;
  text-align: center;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #4A90D9;
  border-radius: 2rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #4A90D9;
  font-weight: bold;
}

.order-list {
  padding: 20rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.order-status.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.order-status.paid {
  background-color: #e8f8f0;
  color: #52c41a;
}

.order-status.refunded {
  background-color: #f0f0f0;
  color: #999;
}

.order-status.cancelled {
  background-color: #f0f0f0;
  color: #999;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.course-info {
  flex: 1;
  margin-right: 20rpx;
}

.course-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.course-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.order-amount {
  text-align: right;
}

.amount {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.pay-btn {
  padding: 16rpx 40rpx;
  background-color: #07c160;
  border-radius: 32rpx;
}

.pay-btn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}

.empty-state {
  padding: 150rpx 50rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  padding: 50rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.no-more {
  padding: 30rpx;
  text-align: center;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
}
