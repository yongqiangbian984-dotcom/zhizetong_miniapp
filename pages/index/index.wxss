.container { min-height: 100vh; background: #f5f5f5; }
.init-entry { margin: 0 24rpx; background: #fff3cd; border: 2rpx solid #ffc107; border-radius: 12rpx; padding: 16rpx 24rpx; text-align: center; }
.init-entry text { font-size: 26rpx; color: #856404; }
.search-bar { padding: 16rpx 24rpx; background: #4A90D9; }
.search-input-wrap { background: rgba(255,255,255,0.95); border-radius: 40rpx; padding: 16rpx 24rpx; display: flex; align-items: center; }
.search-placeholder { color: #999; font-size: 28rpx; }
.banner-section { padding: 20rpx 24rpx; }
.banner-swiper { height: 280rpx; border-radius: 16rpx; overflow: hidden; }
.banner-item { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; }
.banner-text { color: #fff; font-size: 36rpx; font-weight: bold; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2); }
.category-nav { display: flex; justify-content: space-around; padding: 24rpx 16rpx; background: #fff; }
.category-item { display: flex; flex-direction: column; align-items: center; }
.category-icon-box { width: 88rpx; height: 88rpx; background: #f0f5ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; }
.category-emoji { font-size: 40rpx; }
.category-name { font-size: 24rpx; color: #666; }
.tools-entry { margin: 20rpx 24rpx; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 16rpx; padding: 28rpx; display: flex; align-items: center; }
.tools-icon { width: 80rpx; height: 80rpx; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.tools-icon text { font-size: 40rpx; }
.tools-info { flex: 1; }
.tools-title { display: block; color: #fff; font-size: 30rpx; font-weight: bold; }
.tools-desc { display: block; color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 4rpx; }
.tools-arrow { color: #fff; font-size: 40rpx; }
.zexiao-entry { margin: 20rpx 24rpx; background: linear-gradient(135deg, #1a1814, #2d2518); border-radius: 16rpx; padding: 28rpx; display: flex; align-items: center; border: 1px solid #D4AF37; }
.zexiao-icon { width: 80rpx; height: 80rpx; background: rgba(212,175,55,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.zexiao-icon text { font-size: 40rpx; }
.zexiao-info { flex: 1; }
.zexiao-title { display: block; color: #D4AF37; font-size: 30rpx; font-weight: bold; }
.zexiao-desc { display: block; color: rgba(212,175,55,0.7); font-size: 24rpx; margin-top: 4rpx; }
.zexiao-arrow { color: #D4AF37; font-size: 40rpx; }
.free-section { margin: 20rpx 24rpx; background: linear-gradient(135deg, #52c41a, #73d13d); border-radius: 16rpx; padding: 24rpx; display: flex; justify-content: space-between; align-items: center; }
.free-left { display: flex; align-items: center; }
.free-badge { background: #fff; color: #52c41a; font-size: 22rpx; font-weight: bold; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 16rpx; }
.free-info { display: flex; flex-direction: column; }
.free-title { color: #fff; font-size: 30rpx; font-weight: bold; }
.free-desc { color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 4rpx; }
.free-arrow { color: #fff; font-size: 28rpx; }
.section { margin-top: 20rpx; background: #fff; padding: 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; }
.section-more { font-size: 26rpx; color: #999; }
.hot-scroll { white-space: nowrap; }
.hot-card { display: inline-block; width: 300rpx; margin-right: 20rpx; vertical-align: top; }
.hot-cover { height: 180rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.hot-cover-text { color: #fff; font-size: 26rpx; font-weight: bold; padding: 0 16rpx; text-align: center; }
.hot-badge { position: absolute; top: 8rpx; right: 8rpx; background: #52c41a; color: #fff; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.hot-info { padding: 12rpx 0; }
.hot-title { font-size: 26rpx; color: #333; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; white-space: normal; }
.hot-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.hot-price { color: #f5222d; font-size: 32rpx; font-weight: bold; }
.hot-price-free { color: #52c41a; font-size: 28rpx; font-weight: bold; }
.hot-students { color: #999; font-size: 22rpx; }
.new-list { }
.new-item { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.new-item:last-child { border-bottom: none; }
.new-cover { width: 200rpx; height: 140rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; }
.new-cover-text { color: #fff; font-size: 22rpx; font-weight: bold; padding: 0 8rpx; text-align: center; }
.new-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
.new-title { font-size: 28rpx; color: #333; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.new-desc { font-size: 24rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4rpx; }
.new-meta { display: flex; align-items: center; margin-top: 8rpx; }
.new-price { color: #f5222d; font-size: 30rpx; font-weight: bold; margin-right: 16rpx; }
.new-price-free { color: #52c41a; font-size: 26rpx; font-weight: bold; margin-right: 16rpx; }
.new-teacher { color: #999; font-size: 22rpx; margin-right: 16rpx; }
.new-students { color: #999; font-size: 22rpx; }

.hot-cover-img { width: 100%; height: 100%; }
.new-cover-img { width: 100%; height: 100%; }
