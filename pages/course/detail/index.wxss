.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx; }
.course-header { padding: 40rpx 30rpx; color: #fff; position: relative; }
.course-title { font-size: 36rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.course-price-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.course-price { font-size: 40rpx; font-weight: bold; margin-right: 12rpx; }
.course-price-free { font-size: 36rpx; font-weight: bold; margin-right: 12rpx; }
.course-original { font-size: 24rpx; text-decoration: line-through; opacity: 0.7; }
.course-students { font-size: 24rpx; opacity: 0.85; }
.course-resource-tag { position: absolute; top: 20rpx; right: 20rpx; background: rgba(255,255,255,0.25); border-radius: 20rpx; padding: 6rpx 16rpx; }
.resource-tag-text { font-size: 22rpx; color: #fff; }
.tab-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #4A90D9; font-weight: bold; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 30%; right: 30%; height: 4rpx; background: #4A90D9; border-radius: 2rpx; }
.tab-content { padding: 20rpx 24rpx; }
.intro-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.intro-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.intro-text { font-size: 26rpx; color: #666; line-height: 1.8; display: block; margin-bottom: 8rpx; }
.chapter-item { background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; overflow: hidden; }
.chapter-item:active { background: #f9f9f9; }
.chapter-header { display: flex; align-items: center; padding: 24rpx; }
.chapter-index { width: 48rpx; height: 48rpx; background: #4A90D9; color: #fff; border-radius: 50%; text-align: center; line-height: 48rpx; font-size: 24rpx; margin-right: 16rpx; flex-shrink: 0; }
.chapter-title { flex: 1; font-size: 28rpx; color: #333; }
.chapter-type { font-size: 32rpx; }
.chapter-free { font-size: 22rpx; color: #4CAF50; background: #E8F5E9; padding: 2rpx 12rpx; border-radius: 4rpx; margin-left: 10rpx; }
.chapter-locked { font-size: 24rpx; margin-left: 10rpx; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 24rpx; background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); }
.buy-btn { background: linear-gradient(135deg, #4A90D9, #6BA3E0); color: #fff; text-align: center; padding: 24rpx; border-radius: 44rpx; font-size: 32rpx; font-weight: bold; }
.resource-card { background: linear-gradient(135deg, #f8f9ff, #fff); border: 1rpx solid #e8eeff; }
.resource-card.resource-locked { background: linear-gradient(135deg, #fff9f0, #fff); border: 1rpx solid #ffe8cc; }
.resource-info { background: #f8f9ff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.resource-item { display: flex; margin-bottom: 12rpx; }
.resource-item:last-child { margin-bottom: 0; }
.resource-label { width: 100rpx; font-size: 24rpx; color: #999; flex-shrink: 0; }
.resource-value { font-size: 24rpx; color: #333; word-break: break-all; }
.resource-value.password { color: #4A90D9; font-weight: bold; letter-spacing: 2rpx; }
.resource-action { background: linear-gradient(135deg, #4A90D9, #6BA3E0); color: #fff; text-align: center; padding: 20rpx; border-radius: 24rpx; margin-top: 16rpx; }
.resource-action.contact-action { background: linear-gradient(135deg, #ff9800, #ffb74d); }
.resource-action:active { opacity: 0.9; }
.resource-action-text { font-size: 28rpx; font-weight: bold; }
.course-header-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.course-header-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); }
