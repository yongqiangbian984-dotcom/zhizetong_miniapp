.container { min-height: 100vh; background: #f5f5f5; }
.category-tabs { background: #fff; padding: 16rpx 0; border-bottom: 1rpx solid #eee; }
.tabs-scroll { white-space: nowrap; }
.tabs-list { display: flex; padding: 0 24rpx; }
.tab-item { padding: 12rpx 28rpx; font-size: 28rpx; color: #666; border-radius: 30rpx; margin-right: 16rpx; background: #f5f5f5; }
.tab-item.active { background: #4A90D9; color: #fff; }
.course-list { padding: 20rpx 24rpx; }
.course-item { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; }
.course-cover { width: 200rpx; height: 140rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; }
.course-cover-text { color: #fff; font-size: 22rpx; font-weight: bold; padding: 0 8rpx; text-align: center; }
.course-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
.course-title { font-size: 28rpx; color: #333; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.course-desc { font-size: 24rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4rpx; }
.course-meta { display: flex; align-items: center; margin-top: 8rpx; }
.course-price { color: #f5222d; font-size: 30rpx; font-weight: bold; margin-right: 12rpx; }
.course-price-free { color: #52c41a; font-size: 26rpx; font-weight: bold; margin-right: 12rpx; }
.course-original-price { color: #ccc; font-size: 22rpx; text-decoration: line-through; margin-right: 16rpx; }
.course-students { color: #999; font-size: 22rpx; }
.empty-state { text-align: center; padding: 100rpx 0; }
.empty-text { color: #999; font-size: 28rpx; }
.course-cover-img { width: 100%; height: 100%; }
