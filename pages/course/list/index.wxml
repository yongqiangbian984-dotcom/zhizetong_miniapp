<view class="container">
  <view class="category-tabs">
    <scroll-view class="tabs-scroll" scroll-x="true">
      <view class="tabs-list">
        <view class="tab-item {{currentCategory === 'all' ? 'active' : ''}}" data-id="all" bindtap="onCategoryChange">全部</view>
        <view class="tab-item {{currentCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryChange">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="course-list">
    <view class="course-item" wx:for="{{courses}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="course-cover" wx:if="{{item.coverUrl}}" style="overflow:hidden;">
        <image class="course-cover-img" src="{{item.coverUrl}}" mode="aspectFill"></image>
      </view>
      <view class="course-cover" wx:else style="background: linear-gradient(135deg, {{item.color1 || '#667eea'}}, {{item.color2 || '#764ba2'}});">
        <text class="course-cover-text">{{item.title}}</text>
      </view>
      <view class="course-content">
        <view class="course-title">{{item.title}}</view>
        <view class="course-desc">{{item.description}}</view>
        <view class="course-meta">
          <text class="course-price" wx:if="{{!item.isFree}}">¥{{item.price}}</text>
          <text class="course-price-free" wx:else>免费</text>
          <text class="course-original-price" wx:if="{{!item.isFree && item.originalPrice}}">¥{{item.originalPrice}}</text>
          <text class="course-students">{{item.studentCount}}人学习</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{courses.length === 0}}">
      <text class="empty-text">暂无相关课程</text>
    </view>
  </view>
</view>
