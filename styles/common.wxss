/* 全局样式文件 */
/* 基础样式 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
  line-height: 1.6;
}

/* 容器 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 主色调 */
.text-primary { color: #4A90D9; }
.text-success { color: #52c41a; }
.text-warning { color: #faad14; }
.text-danger { color: #f5222d; }
.text-gray { color: #999; }
.text-white { color: #fff; }

.bg-primary { background-color: #4A90D9; }
.bg-white { background-color: #fff; }
.bg-gray { background-color: #f5f5f5; }

/* Flex布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-around { display: flex; align-items: center; justify-content: space-around; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.align-center { align-items: center; }
.align-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }
.px-20 { padding-left: 20rpx; padding-right: 20rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

/* 文字 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-bold { font-weight: bold; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 44rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* 圆角 */
.radius-sm { border-radius: 8rpx; }
.radius { border-radius: 16rpx; }
.radius-lg { border-radius: 24rpx; }
.radius-round { border-radius: 999rpx; }

/* 阴影 */
.shadow { box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08); }
.shadow-lg { box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12); }

/* 按钮 */
.btn-primary {
  background-color: #4A90D9;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-outline {
  background-color: transparent;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 44rpx;
  padding: 18rpx 38rpx;
  text-align: center;
  font-size: 30rpx;
}

.btn-block {
  width: 100%;
  display: block;
}

/* 卡片 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-state .empty-text {
  color: #999;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 价格 */
.price-symbol { font-size: 24rpx; color: #f5222d; }
.price-value { font-size: 40rpx; color: #f5222d; font-weight: bold; }
.price-original { font-size: 24rpx; color: #999; text-decoration: line-through; margin-left: 10rpx; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.tag-primary { background-color: rgba(74,144,217,0.1); color: #4A90D9; }
.tag-success { background-color: rgba(82,196,26,0.1); color: #52c41a; }
.tag-warning { background-color: rgba(250,173,20,0.1); color: #faad14; }
.tag-danger { background-color: rgba(245,34,45,0.1); color: #f5222d; }
.tag-free { background-color: rgba(82,196,26,0.1); color: #52c41a; }

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}
