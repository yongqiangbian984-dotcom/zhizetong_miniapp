page { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 28rpx; color: #333; background: #f5f5f5; line-height: 1.6; }
.container { min-height: 100vh; box-sizing: border-box; padding-bottom: 20rpx; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-ellipsis-2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.safe-bottom { height: 30rpx; }
